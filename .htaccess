RewriteEngine On

# Endereços com .html redirecionam para a versão sem extensão (ex.: /koinonia.html -> /koinonia)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(admin|links|quem-somos|ofertas|koinonia|shalom-online|todas-as-localidades)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Barra no final também vai para a versão sem barra (ex.: /koinonia/ -> /koinonia)
RewriteRule ^(admin|links|quem-somos|ofertas|koinonia|shalom-online|todas-as-localidades)/$ /$1 [R=301,L]

# Sistema de ingressos: link de venda /e/{evento}, painel e check-in
RewriteRule ^e/([a-z0-9-]+)/?$ ingressos/checkout.php?evento=$1 [L,QSA]
RewriteRule ^painel/?$ ingressos/painel/index.html [L]
RewriteRule ^checkin/?$ ingressos/checkin/index.html [L]

# Não reescreve arquivos e pastas que realmente existem (assets, api, php, páginas .html etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /admin e /links carregam os respectivos arquivos .html por baixo dos panos
RewriteRule ^(admin|links)$ $1.html [L]

# URLs limpas das páginas do novo site: /quem-somos, /ofertas, /koinonia...
RewriteRule ^(quem-somos|ofertas|koinonia|shalom-online|todas-as-localidades)$ $1.html [L]

# Endereços antigos continuam funcionando
RewriteRule ^sobre/?$ /quem-somos [R=301,L]
RewriteRule ^celulas/?$ /todas-as-localidades [R=301,L]
