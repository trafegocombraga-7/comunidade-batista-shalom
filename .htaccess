RewriteEngine On

# admin.html e links.html: se alguém acessar com .html, redireciona para a URL sem extensão
RewriteCond %{THE_REQUEST} \s/+(admin|links)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Não reescreve arquivos e pastas que realmente existem (assets, api, php, páginas .html etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /admin e /links carregam os respectivos arquivos .html por baixo dos panos
RewriteRule ^(admin|links)/?$ $1.html [L]

# URLs limpas das páginas do novo site: /quem-somos, /ofertas, /koinonia...
RewriteRule ^(quem-somos|ofertas|koinonia|shalom-online|todas-as-localidades)/?$ $1.html [L]

# Endereços antigos continuam funcionando
RewriteRule ^sobre/?$ /quem-somos.html [R=301,L]
RewriteRule ^celulas/?$ /todas-as-localidades.html [R=301,L]
